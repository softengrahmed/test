resource \"google_compute_firewall\" \"default\" {\n  name    = \"default-allow-internal\"\n  network = var.network_name\n\n  allow {\n    protocol = \"icmp\"\n  }\n\n  allow {\n    protocol = \"tcp\"\n    ports    = [\"0-65535\"]\n  }\n\n  allow {\n    protocol = \"udp\"\n    ports    = [\"0-65535\"]\n  }\n\n  source_ranges = [\"10.0.0.0/8\"]\n}\n\noutput \"rule_names\" {\n  value = google_compute_firewall.default.name\n}\n